@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<div class="panel">
    <h1>Что-то пошло не так</h1>
    <p class="subtitle">При обработке запроса произошла ошибка.</p>
    @if (Model.ShowRequestId)
    {
        <p>Код запроса: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Products" asp-action="Index" class="btn btn-accent">В каталог</a>
</div>
