<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Аксессуары сервисного центра</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        bool isImport = action == "Import" || action == "Upload";
    }

    <header class="site-header">
        <div class="container">
            <div class="site-title">Сервисный центр: магазин аксессуаров</div>
            <div class="site-subtitle">Импорт товаров из CSV-файлов</div>
        </div>
    </header>

    <div class="container">
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link @(isImport ? "" : "active")" asp-controller="Products" asp-action="Index">Список товаров</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(isImport ? "active" : "")" asp-controller="Products" asp-action="Import">Импорт товаров</a>
            </li>
        </ul>

        <div class="page">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }
            @RenderBody()
        </div>

        <footer class="text-center text-muted small py-4">
            Новикова Александра, ПП.02.01, вариант 3
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
