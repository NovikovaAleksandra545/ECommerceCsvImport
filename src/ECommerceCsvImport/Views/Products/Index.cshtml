@model ProductsIndexViewModel
@{
    ViewData["Title"] = "Список товаров";
}

<h1>Список товаров</h1>

@if (Model.AllCount == 0)
{
    <p>Товары еще не импортированы.</p>
    <a asp-action="Import" class="btn btn-success">Импортировать товары</a>
}
else
{
    <form method="get" asp-action="Index" class="row g-2 mb-3">
        <div class="col-auto">
            <input type="search" name="search" value="@Model.Search" class="form-control" style="width: 190px" placeholder="Поиск по названию" />
        </div>
        <div class="col-auto">
            <select name="category" class="form-select">
                <option value="">Все категории</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c" selected="@(c == Model.Category)">@c</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <select name="size" class="form-select">
                <option value="">Все размеры</option>
                @foreach (var s in Model.Sizes)
                {
                    <option value="@s" selected="@(s == Model.Size)">@s</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <select name="sort" class="form-select">
                <option value="">Без сортировки</option>
                <option value="name" selected="@(Model.Sort == "name")">По названию</option>
                <option value="price_asc" selected="@(Model.Sort == "price_asc")">Цена по возрастанию</option>
                <option value="price_desc" selected="@(Model.Sort == "price_desc")">Цена по убыванию</option>
                <option value="stock" selected="@(Model.Sort == "stock")">По остатку</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-success">Показать</button>
            <a asp-action="Index" class="btn btn-link">Сбросить</a>
        </div>
    </form>

    <p>
        Товаров: <b>@Model.Products.Count</b> из @Model.AllCount,
        на складе: <b>@Model.TotalStock</b> шт.,
        стоимость остатков: <b>@Model.TotalValue.ToString("N0")</b> руб.
    </p>

    <table class="table table-bordered table-striped table-sm">
        <tr>
            <th>Артикул</th>
            <th>Название</th>
            <th>Цена</th>
            <th>Категория</th>
            <th>Остаток</th>
            <th>Размер</th>
            <th>Цвет</th>
            <th>Материал</th>
            <th>Активен</th>
        </tr>
        @foreach (var p in Model.Products)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@p.Sku">@p.Sku</a></td>
                <td>@p.Name</td>
                <td>@p.Price.ToString("N0") @p.Currency</td>
                <td>@p.CategoryName</td>
                <td>@p.StockQuantity</td>
                <td>@p.Size</td>
                <td>@p.Color</td>
                <td>@p.Material</td>
                <td>@(p.IsActive ? "Да" : "Нет")</td>
            </tr>
        }
    </table>

    <div class="d-flex gap-2">
        <a asp-action="Import" class="btn btn-success">Импортировать еще</a>
        <a class="btn btn-outline-secondary" asp-action="Export" asp-route-search="@Model.Search"
           asp-route-category="@Model.Category" asp-route-size="@Model.Size" asp-route-sort="@Model.Sort">Экспорт в CSV</a>
        <form method="post" asp-action="Clear" onsubmit="return confirm('Удалить все товары?')">
            <button type="submit" class="btn btn-outline-danger">Очистить список</button>
        </form>
    </div>
}
