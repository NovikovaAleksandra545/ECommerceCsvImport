@model Product
@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>

<table class="table table-bordered" style="max-width: 600px">
    <tr><th style="width: 200px">Артикул</th><td>@Model.Sku</td></tr>
    <tr><th>Описание</th><td>@Model.Description</td></tr>
    <tr><th>Цена</th><td>@Model.Price.ToString("N2") @Model.Currency</td></tr>
    <tr><th>Категория</th><td>@Model.CategoryName</td></tr>
    <tr><th>Остаток</th><td>@Model.StockQuantity шт.</td></tr>
    <tr><th>Размер</th><td>@Model.Size</td></tr>
    <tr><th>Цвет</th><td>@Model.Color</td></tr>
    <tr><th>Материал</th><td>@Model.Material</td></tr>
    <tr><th>Изображение</th><td>@Model.ImageUrl</td></tr>
    <tr><th>Активен</th><td>@(Model.IsActive ? "Да" : "Нет")</td></tr>
</table>

<a asp-action="Index">Назад к списку</a>
