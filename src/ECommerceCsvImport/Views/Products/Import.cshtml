@model ImportViewModel
@{
    ViewData["Title"] = "Импорт товаров";
    var result = Model.Result;
}

<h1>Импорт товаров из CSV</h1>

<form method="post" asp-action="Import" class="mb-3">
    <label for="filePath" class="form-label">Путь к CSV-файлу</label>
    <div class="input-group" style="max-width: 600px">
        <input type="text" id="filePath" name="filePath" value="@Model.FilePath" class="form-control" placeholder="/csv/sample_products.csv" />
        <button type="submit" class="btn btn-success">Импортировать</button>
    </div>
    <div class="form-text">Например: /csv/sample_products.csv или C:\data\products.csv</div>
</form>

@if (Model.SampleFiles.Count > 0)
{
    <p class="small">
        Файлы для проверки:
        @foreach (var file in Model.SampleFiles)
        {
            <a href="#" data-path="@file" class="me-2">@System.IO.Path.GetFileName(file)</a>
        }
    </p>
}

<form method="post" asp-action="Upload" enctype="multipart/form-data" class="mb-4">
    <label for="file" class="form-label">Или выберите файл на компьютере</label>
    <div class="input-group" style="max-width: 600px">
        <input type="file" id="file" name="file" accept=".csv" class="form-control" required />
        <button type="submit" class="btn btn-outline-success">Загрузить</button>
    </div>
</form>

@if (result != null)
{
    <h2 class="h4" id="import-result">Результат импорта @(result.FileName != "" ? "(" + result.FileName + ")" : "")</h2>

    <table class="table table-bordered" style="max-width: 400px">
        <tr><th>Показатель</th><th>Значение</th></tr>
        <tr><td>Всего строк</td><td>@result.TotalRows</td></tr>
        <tr><td>Успешно импортировано</td><td>@result.ImportedCount</td></tr>
        <tr><td>Ошибки</td><td>@result.ErrorCount</td></tr>
    </table>

    @if (result.ErrorCount > 0)
    {
        <h3 class="h5">Список ошибок</h3>
        <table class="table table-bordered table-sm">
            <tr><th style="width: 80px">Строка</th><th>Описание ошибки</th></tr>
            @foreach (var error in result.Errors)
            {
                <tr>
                    <td>@(error.RowNumber == 0 ? "-" : error.RowNumber.ToString())</td>
                    <td>@error.Message</td>
                </tr>
            }
        </table>
    }

    <a asp-action="Index" class="btn btn-outline-success">Перейти к списку товаров</a>
}
